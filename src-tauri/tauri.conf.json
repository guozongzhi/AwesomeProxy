{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AwesomeProxy",
  "version": "0.1.0",
  "identifier": "com.awesomeproxy.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "AwesomeProxy Settings",
        "width": 960,
        "height": 720,
        "resizable": true,
        "fullscreen": false,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "binaries/*"
    ]
  }
}
